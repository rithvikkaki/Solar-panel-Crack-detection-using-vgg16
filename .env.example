# SolarSentinel AI - Environment Configuration

# Server runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Security & CORS (comma-separated list of allowed origins)
# Vercel deployments (*.vercel.app) are automatically permitted by CORS regex
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Model Configuration (Production Champion: 384x384 VGG16)
MODEL_PATH=ml/models/best_vgg16.keras
CLASS_NAMES_PATH=ml/metadata/class_names.json
MODEL_INPUT_HEIGHT=384
MODEL_INPUT_WIDTH=384