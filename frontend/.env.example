# SolarSentinel AI - Frontend Environment Configuration
#
# For Local Development:
# Set VITE_API_URL to your local backend server (default: http://127.0.0.1:8000)
# Leaving this empty also works with Vite's dev server proxy (/api -> http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# For Production Deployment on Vercel:
# Set VITE_API_URL in the Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://<your-username>-<space-name>.hf.space
# Example: VITE_API_URL=https://huggingface.co/spaces/username/solarsentinel-api (or direct direct .hf.space URL)
